# copy this file to .env and fill in your own values (.env is ignored by git)

# https port on your machine, https://localhost:<HTTPS_PORT>
HTTPS_PORT=443

# django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost

# postgres (the same values are used by the db container and by django)
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
